# Copy this file to .env and fill in your values
# Get these from Telegram — see README.md for setup steps

TELEGRAM_TOKEN=your_bot_token_here

# Admin chat ID — only this user can run /short, /long, /both, /pause, /resume
TELEGRAM_CHAT_ID=your_chat_id_here

# Comma-separated list of chat IDs that receive alerts and can use /status, /help.
# Include the admin ID here too. Leave blank to only send to TELEGRAM_CHAT_ID.
# Example: TELEGRAM_BROADCAST_IDS=111111111,222222222
TELEGRAM_BROADCAST_IDS=
