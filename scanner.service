[Unit]
Description=Binance Short Scanner
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/binance-short-scanner
EnvironmentFile=/home/ubuntu/binance-short-scanner/.env
ExecStart=/usr/bin/python3 /home/ubuntu/binance-short-scanner/scanner.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
